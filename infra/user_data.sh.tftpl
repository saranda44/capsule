#!/bin/bash
set -e

# Actualizar el sistema e instalar Nginx, Git y Node.js
dnf update -y
dnf install -y nginx git nodejs

# Habilitar e iniciar el servicio Nginx
systemctl enable nginx
systemctl start nginx

# Clonar el repositorio del proyecto
REPO_DIR="/var/www/capsule"
rm -rf "$REPO_DIR"
git clone ${repo_url} "$REPO_DIR"

# Instalar dependencias y compilar la aplicación React (Vite)
cd "$REPO_DIR/app"
npm install
npm run build

# Desplegar los archivos estáticos compilados en el directorio web de Nginx
rm -rf /usr/share/nginx/html/*
cp -r dist/* /usr/share/nginx/html/
chmod -R 755 /usr/share/nginx/html

# Configurar Nginx con soporte para ruteo en Single Page Application (SPA)
cat <<'EOF' > /etc/nginx/conf.d/react.conf
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
EOF

# Reiniciar Nginx para aplicar la configuración
systemctl restart nginx
