#!/bin/bash
set -e

# 1. Actualizar el sistema e instalar Git y Nginx
dnf update -y
dnf install -y git nginx

# 2. Desinstalar la versión nativa de Node.js 18 para permitir la instalación de Node.js 20
dnf remove -y nodejs nodejs-full-i18n || true

# 3. Configurar e instalar Node.js 20 (LTS) desde NodeSource
curl -fsSL https://rpm.nodesource.com/setup_20.x | bash -
dnf install -y nodejs

# 4. Habilitar e iniciar Nginx
systemctl enable nginx
systemctl start nginx

# 5. Clonar el repositorio del proyecto
REPO_DIR="/var/www/capsule"
rm -rf "$REPO_DIR"
git clone ${repo_url} "$REPO_DIR"

# 6. Instalar dependencias y compilar la aplicación React en app/
cd "$REPO_DIR/app"
npm install
npm run build

# 7. Desplegar los archivos estáticos compilados en el directorio web de Nginx
rm -rf /usr/share/nginx/html/*
cp -r dist/* /usr/share/nginx/html/
chmod -R 755 /usr/share/nginx/html

# 8. Configurar Nginx para ruteo SPA (Single Page Application)
cat <<'EOF' > /etc/nginx/default.d/spa.conf
location / {
    try_files $uri $uri/ /index.html;
}
EOF

# 9. Reiniciar Nginx para aplicar los cambios
systemctl restart nginx
